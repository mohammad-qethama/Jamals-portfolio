---

---

<section class="overflow-hidden px-6">
    <div
        class="relative overflow-hidden py-20 px-6 text-center"
        style="
      background:
        radial-gradient(circle at 15% 20%, rgba(62,124,177,.18), transparent 45%),
        radial-gradient(circle at 85% 80%, rgba(62,124,177,.12), transparent 50%),
        linear-gradient(160deg,#0B1F3A 0%,#0E2748 55%,#0A1930 100%);
    "
    >
        <!-- Blueprint Grid -->
        <svg
            class="absolute inset-0 h-full w-full opacity-5"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
        >
            <defs>
                <pattern
                    id="grid"
                    width="32"
                    height="32"
                    patternUnits="userSpaceOnUse"
                >
                    <path
                        d="M32 0 L0 0 0 32"
                        fill="none"
                        stroke="white"
                        stroke-width="1"></path>
                </pattern>
            </defs>

            <rect width="100%" height="100%" fill="url(#grid)"></rect>
        </svg>

        <div class="relative z-10 mx-auto max-w-2xl">
            <p
                class="mb-4 text-xs font-semibold uppercase tracking-[0.12em] text-sky-300"
            >
                Aeronautical Engineer
            </p>

            <h1
                class="mb-4 text-5xl font-semibold tracking-tight text-white md:text-6xl"
            >
                Jamal Mousa
            </h1>

            <p class="mx-auto mb-8 max-w-md leading-7 text-slate-400">
                Composite structures &amp; MRO specialist — repair, analysis,
                and structural integrity for commercial aircraft.
            </p>

            <div class="flex flex-wrap justify-center gap-4">
                <a
                    href="#projects"
                    class="rounded-lg bg-gradient-to-br from-red-500 to-red-700 px-6 py-3 font-medium text-white shadow-lg shadow-red-500/30 transition hover:-translate-y-1"
                >
                    View Projects
                </a>

                <a
                    href="/resume.pdf"
                    class="rounded-lg border border-white/20 bg-white/5 px-6 py-3 font-medium text-white backdrop-blur transition hover:bg-white/10"
                >
                    Download Resume
                </a>
            </div>
        </div>
    </div>
</section>
