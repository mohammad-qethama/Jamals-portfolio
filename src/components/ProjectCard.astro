---
// src/components/ProjectCard.astro
interface Props {
    slug: string;
    title: string;
    description: string;
    cover: string;
    tags?: string[];
}

const { slug, title, description, cover, tags = [] } = Astro.props;
---

<a
    href={`/projects/${slug}`}
    class="block rounded-xl border border-slate/20 overflow-hidden bg-white hover:shadow-md hover:border-steel/40 transition"
>
    <div class="h-40 bg-surface overflow-hidden">
        <img
            src={cover}
            alt={title}
            loading="lazy"
            class="w-full h-full object-cover"
        />
    </div>

    <div class="p-4">
        {
            tags.length > 0 && (
                <div class="flex gap-1.5 flex-wrap mb-2">
                    {tags.map((tag) => (
                        <span class="text-xs bg-steel/10 text-steel font-medium px-2.5 py-0.5 rounded-full">
                            {tag}
                        </span>
                    ))}
                </div>
            )
        }

        <h3 class="text-navy font-medium text-[15px] mb-1">{title}</h3>
        <p class="text-sm text-slate leading-relaxed mb-2.5 line-clamp-2">
            {description}
        </p>
        <span class="text-xs font-medium text-accent">View gallery →</span>
    </div>
</a>
