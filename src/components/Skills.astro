---
// src/components/Skills.astro
interface Props {
    skills: string[];
}

const { skills } = Astro.props;
---

<section class="bg-white">
    <div class="max-w-content mx-auto px-6 py-16 sm:py-20">
        <p
            class="text-xs uppercase tracking-[0.12em] text-steel font-semibold mb-3"
        >
            Core competencies
        </p>
        <h2 class="text-2xl sm:text-3xl font-semibold text-navy mb-10">
            Skills
        </h2>

        <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-5"
        >
            {
                skills.map((skill) => (
                    <div class="flex items-center gap-3 border-b border-slate/15 pb-3">
                        <span class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0" />
                        <span class="text-sm font-medium text-navy">
                            {skill}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</section>
