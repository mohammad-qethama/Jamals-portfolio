---
// src/components/Nav.astro
const links = [
    { href: "/", label: "Home" },
    { href: "/projects", label: "Projects" },
    { href: "/resume", label: "Resume" },
    { href: "/contact", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-navy border-b border-navy/40">
    <nav class="max-w-dvw w-full px-6 flex items-center justify-between h-16">
        <a href="/" class="font-semibold text-white tracking-tight">JM</a>

        <ul class="hidden sm:flex items-center gap-8">
            {
                links.map((link) => {
                    const isActive = currentPath === link.href;
                    const linkClass = isActive
                        ? "text-sm font-medium text-white"
                        : "text-sm text-slate hover:text-white transition-colors";
                    return (
                        <li>
                            <a href={link.href} class={linkClass}>
                                {link.label}
                            </a>
                        </li>
                    );
                })
            }
        </ul>

        <button
            id="menu-btn"
            class="sm:hidden p-2 -mr-2 text-white"
            aria-label="Toggle menu"
            aria-expanded="false"
        >
            <svg
                id="icon-open"
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
            </svg>
            <svg
                id="icon-close"
                class="w-6 h-6 hidden"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </nav>

    <div
        id="mobile-menu"
        class="hidden sm:hidden border-t border-navy/40 bg-navy"
    >
        <ul class="px-6 py-3 space-y-1">
            {
                links.map((link) => {
                    const isActive = currentPath === link.href;
                    const linkClass = isActive
                        ? "block py-2 text-sm font-medium text-white"
                        : "block py-2 text-sm text-slate hover:text-white";
                    return (
                        <li>
                            <a href={link.href} class={linkClass}>
                                {link.label}
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</header>

<script>
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    btn?.addEventListener("click", () => {
        const isOpen = !menu?.classList.contains("hidden");
        menu?.classList.toggle("hidden");
        iconOpen?.classList.toggle("hidden");
        iconClose?.classList.toggle("hidden");
        btn.setAttribute("aria-expanded", String(!isOpen));
    });
</script>
