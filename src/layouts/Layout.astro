---
import Navigator from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Jamal Mousa Portfolio</title>
    </head>
    <body class="">
        <Navigator />

        <main class="max-w-7xl mx-auto">
            <slot />
        </main>
        <Footer
            name="Jamal Mousa"
            links={[
                {
                    label: "Email",
                    href: "mailto:jamal@example.com",
                    icon: "heroicons:envelope",
                },
                {
                    label: "LinkedIn",
                    href: "https://linkedin.com/in/jamal-mousa",
                    icon: "simple-icons:linkedin",
                    external: true,
                },
                {
                    label: "Resume PDF",
                    href: "/resume.pdf",
                    icon: "heroicons:document-text",
                    external: true,
                },
                {
                    label: "Portfolio PDF",
                    href: "/portfolio.pdf",
                    icon: "heroicons:document-text",
                    external: true,
                },
            ]}
        />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
